    {
      "name": "GET PHARMACY",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Test 1: Verify status code is 200",
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "// Test 2: Verify response time is reasonable (under 2000ms)",
              "pm.test(\"Response time is under 2000ms\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(2000);",
              "});",
              "",
              "// Test 3: Verify response is an array",
              "pm.test(\"Response is an array\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.be.an('array');",
              "});",
              "",
              "// Test 4: Verify array is not empty",
              "pm.test(\"Response array is not empty\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.length).to.be.above(0);",
              "});",
              "",
              "// Test 5: Verify each pharmacy object has required fields with correct types",
              "pm.test(\"Each pharmacy has required fields with correct types\", function () {",
              "    const jsonData = pm.response.json();",
              "    ",
              "    jsonData.forEach((pharmacy, index) => {",
              "        // Verify ID_P exists and is a number",
              "        pm.expect(pharmacy).to.have.property('ID_P');",
              "        pm.expect(pharmacy.ID_P).to.be.a('number');",
              "        ",
              "        // Verify NAME exists and is a string",
              "        pm.expect(pharmacy).to.have.property('NAME');",
              "        pm.expect(pharmacy.NAME).to.be.a('string');",
              "        ",
              "        // Verify ADDRESS exists and is a string",
              "        pm.expect(pharmacy).to.have.property('ADDRESS');",
              "        pm.expect(pharmacy.ADDRESS).to.be.a('string');",
              "    });",
              "});",
              "",
              "// Test 6: Verify response structure matches expected schema",
              "pm.test(\"Response structure matches expected pharmacy schema\", function () {",
              "    const jsonData = pm.response.json();",
              "    const expectedKeys = ['ID_P', 'NAME', 'ADDRESS'];",
              "    ",
              "    jsonData.forEach((pharmacy) => {",
              "        // Verify each object has exactly the expected keys",
              "        const actualKeys = Object.keys(pharmacy);",
              "        pm.expect(actualKeys.sort()).to.eql(expectedKeys.sort());",
              "        ",
              "        // Verify NAME and ADDRESS are non-empty strings",
              "        pm.expect(pharmacy.NAME.trim()).to.not.be.empty;",
              "        pm.expect(pharmacy.ADDRESS.trim()).to.not.be.empty;",
              "        ",
              "        // Verify ID_P is a positive integer",
              "        pm.expect(pharmacy.ID_P).to.be.above(0);",
              "        pm.expect(Number.isInteger(pharmacy.ID_P)).to.be.true;",
              "    });",
              "});",
              "",
              "// Test 7: Verify Content-Type header",
              "pm.test(\"Content-Type header is application/json\", function () {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json');",
              "});"
            ]
          }
        }
      ],
